# Cross-repo code search REQUIRES a PAT (fine-grained with "Code search" /
# public repo read, or a classic token). The default Actions GITHUB_TOKEN
# cannot do cross-repo code search.
GITHUB_PAT=ghp_your_token_here

# Cloudflare R2 (image hosting). If any of these are unset the sync still runs
# but images are processed and NOT uploaded (NullStore).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=intracloud-assets

# Where the sync reads/writes the data branch working tree.
# Defaults to <repo>/data-branch.
# DATA_DIR=/path/to/data-branch
