# Cross-repo code search REQUIRES a PAT (classic token with `public_repo`, or a
# fine-grained token). The default Actions GITHUB_TOKEN cannot do cross-repo
# code search. This is the ONLY credential the sync needs.
GITHUB_PAT=ghp_your_token_here

# Where the sync reads/writes the data branch working tree.
# Defaults to <repo>/data-branch.
# DATA_DIR=/path/to/data-branch

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — only if you later move images off the data branch onto a CDN.
# By default images are re-hosted into the data branch (assets/) and served at
# /i/{sha}.webp with the site — no object store, no billing, no card required.
#
# To use Cloudflare R2 instead, set ALL of these AND point ASSET_BASE at the
# bucket's public origin:
# ASSET_BASE=https://cdn.intracloud.tech/i
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=intracloud-assets
