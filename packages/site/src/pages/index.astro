---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { homepageFeed } from "../lib/rank.js";
import { SITE_DESCRIPTION } from "../lib/constants.js";

const posts = (await getCollection("posts")).map((e) => e.data);
const { posts: feed, fallback } = homepageFeed(posts);
---

<Base title="Intracloud" description={SITE_DESCRIPTION} path="/">
  <h1>{fallback ? "Recent" : "Latest"}</h1>
  <p class="meta">
    Every <code>intracloud.md</code> on public GitHub, indexed automatically. No
    signup, no form — commit the file, add the <code>intracloud</code> topic,
    and it appears.
  </p>
  {feed.length === 0 ? (
    <p class="banner">No posts yet. The first sync will populate this feed.</p>
  ) : (
    <ul class="post-list">
      {feed.map((post) => <PostCard post={post} />)}
    </ul>
  )}
</Base>
