---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { latestFeed } from "../lib/rank.js";
import { SITE_DESCRIPTION } from "../lib/constants.js";

const posts = (await getCollection("posts")).map((e) => e.data);
const latest = latestFeed(posts);
---

<Base title="Intracloud" description={SITE_DESCRIPTION} path="/">
  <h1>Latest</h1>
  <p class="meta">
    Every <code>intracloud.md</code> on public GitHub, indexed automatically. No
    signup, no form — commit the file and it appears.
  </p>
  {latest.length === 0 ? (
    <p class="banner">No posts yet. The first sync will populate this feed.</p>
  ) : (
    <ul class="post-list">
      {latest.map((post) => <PostCard post={post} />)}
    </ul>
  )}
</Base>
