---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { routableTags } from "../../lib/rank.js";
import { MIN_POSTS_PER_TAG } from "../../lib/constants.js";

const posts = (await getCollection("posts")).map((e) => e.data);
const tags = routableTags(posts);
---

<Base title="Tags" description="Browse posts by tag on Intracloud." path="/t">
  <h1>Tags</h1>
  <p class="lede">
    Topics with at least {MIN_POSTS_PER_TAG} posts get their own page. Thinner
    tags still work as labels on each post.
  </p>
  {tags.length === 0 ? (
    <p class="banner">No tag has enough posts for its own page yet.</p>
  ) : (
    <div class="tag-cloud">
      {tags.map(({ tag, posts }) => (
        <a class="tag tag-count" href={`/t/${tag}`}>
          {tag} <span>{posts.length}</span>
        </a>
      ))}
    </div>
  )}
</Base>
