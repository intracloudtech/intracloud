---
import type { Post } from "@intracloud/schema";
export interface Props {
  post: Post;
  showAuthor?: boolean;
}
const { post, showAuthor = true } = Astro.props;
const date = post.first_seen_at.slice(0, 10);
---

<li>
  <h2><a href={post.url}>{post.title}</a></h2>
  <p class="meta">
    {showAuthor && (<>by <a href={`/@${post.author}`}>@{post.author}</a> · </>)}
    <a href={`/@${post.author}/${post.repo}`}>{post.repo}</a> · <time datetime={post.first_seen_at}>{date}</time>
    {post.backfill && " · archived"}
  </p>
  {post.summary && <p class="summary">{post.summary}</p>}
  {post.tags.length > 0 && (
    <div class="tags">
      {post.tags.map((t) => (<a class="tag" href={`/t/${t}`}>{t}</a>))}
    </div>
  )}
</li>
